# Supabase - development only (sonblade-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key may be used instead of the publishable key during transition.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave SECRETA del servidor (solo servidor; nunca con prefijo NEXT_PUBLIC_, nunca en el navegador
# ni en los registros). La usan "Crear acceso" y "Restablecer PIN" en Equipo (API de administracion
# de Supabase Auth) y el script de arranque. Se prefiere la nueva sb_secret_...; la service_role
# antigua sirve igual. En Vercel va como variable SENSIBLE (ver docs/implementation/ACCESOS.md).
# OBLIGATORIA: sin ella nadie puede iniciar sesion (el login responde 503).
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OBLIGATORIA, solo servidor: 32 bytes aleatorios en hex (openssl rand -hex 32), uno distinto por base.
# El pepper del PIN vive en la base (private.app_secrets) y lo lee el servidor con la llave secreta.
# NO configures PIN_PEPPER en Vercel: solo existe para pruebas automatizadas.

# Negocio con el que se inicia sesion (usuario + PIN). Por omision: gallo-420.
BARBEROS_BUSINESS_SLUG=

# Required only when running the one-time owner bootstrap script.
SONBLADE_BOOTSTRAP_PROJECT_REF=


# Modo de la publicacion (publica, se incrusta al compilar). Solo la version de PRACTICA lleva
# NEXT_PUBLIC_APP_MODE=practice, y SIEMPRE conectada a la base de desarrollo (sonblade-dev), nunca a produccion.
# Ausente o vacia = produccion normal. Ver docs/implementation/PRODUCCION.md ("Entorno de practica").
NEXT_PUBLIC_APP_MODE=
