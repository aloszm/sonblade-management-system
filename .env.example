# Supabase - development only (sonblade-dev)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key may be used instead of the publishable key during transition.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for bootstrap and explicitly authorized server operations.
# Prefer the new Supabase secret key when available; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Required only when running the one-time owner bootstrap script.
SONBLADE_BOOTSTRAP_PROJECT_REF=

